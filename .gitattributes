# Normalise line endings so the tree is identical on every platform and
# pre-commit's mixed-line-ending hook has nothing to fight with.
* text=auto eol=lf

*.py    text eol=lf
*.pyi   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.cff   text eol=lf
*.ipynb text eol=lf

*.png   binary
*.jpg   binary
*.xlsx  binary

# Keep noise out of release tarballs and language statistics.
.github/        export-ignore
tests/          export-ignore
examples/notebooks/** linguist-documentation
